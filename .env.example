# Conexión directa de la app (rol dueño de las tablas: salta RLS).
#
# Postgres local
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tempo

# Supabase: Project Settings → Database → Connection string.
# Todo vive en `public`, así que no hace falta tocar el search_path.
# Para los scripts de db/ usá la conexión directa o el session pooler; el
# transaction pooler (puerto 6543) no admite parámetros de arranque.
# DATABASE_URL=postgres://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Supabase Auth ──────────────────────────────────────────────────────────
# Project Settings → API. Son las mismas que usa tempo_mobile: las cuentas se
# comparten entre el web y el móvil.
#
# La clave publicable viaja al navegador, por eso el prefijo NEXT_PUBLIC_. No
# es un secreto: lo que protege los datos por esa puerta es RLS.
NEXT_PUBLIC_SUPABASE_URL=https://PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ── db:reset ────────────────────────────────────────────────────────────────
# db/00_reset.sql borra public.users pero no auth.users: las cuentas reales de
# Supabase quedan sin perfil. `npm run db:reset` encadena
# db/perfiles-desde-auth.sql para reponerlas, y esta es la única que necesita
# volver a admin (el rol no se lee de raw_user_meta_data — ver ese archivo).
# No en el repo a propósito: es un correo real.
ADMIN_EMAIL=quien@sea-admin.com
